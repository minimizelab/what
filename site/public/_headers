# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

# Speculation-Rules lets Chromium browsers prefetch same-site pages on hover,
# without any JavaScript.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'
  Speculation-Rules: "/speculation-rules.json"

# Hashed build output; safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/speculation-rules.json
  Content-Type: application/speculationrules+json
